# SQLite database location.
# NOTE: Prisma resolves a relative file: URL against prisma/schema.prisma, not
# the project root, so this file is created at prisma/db/custom.db.
# Development only: a serverless filesystem is wiped on every deployment.
DATABASE_URL="file:./db/custom.db"

# Public site origin, used for canonical URLs, Open Graph and the sitemap.
# Nkrabea does not yet hold a domain; set this once it is secured.
NEXT_PUBLIC_SITE_URL="https://nkrabeacultureandarts.org"
