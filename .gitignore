# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep .env.example tracked, ignore actual secrets)
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
*.log
dev.log
server.log

# database. Prisma resolves a relative file: URL against prisma/schema.prisma,
# not the project root, so the SQLite file lands in prisma/db/. Match any
# location so a database of real enquiries can never be committed.
*.db
*.db-journal
*.sqlite
*.sqlite3

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# claude / sandbox artifacts
.claude
.zscripts
upload/
